# Copie para .env. Só variáveis EXPO_PUBLIC_* chegam ao bundle do app —
# e por isso NENHUMA chave secreta pode morar aqui. O app não conhece a Claude
# API, o astro-calc-service nem a service role do Supabase: tudo passa pelo backend.

# Backend Next.js.
# Emulador Android: http://10.0.2.2:3000
# Dispositivo físico: http://SEU_IP_LOCAL:3000 (localhost não resolve no celular)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000
