# Copie para .env.local e preencha. NUNCA comite valores reais.

# ---------------------------------------------------------------------------
# astro-calc-service (FastAPI)
# Local: http://localhost:8000 · Produção: URL do Railway
# ---------------------------------------------------------------------------
ASTRO_CALC_URL=http://localhost:8000
# Timeout por chamada, em ms. Geocoding do Nominatim é lento na primeira vez.
ASTRO_CALC_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Gemini API (Google AI Studio) — interpretação em PT-BR. Só server-side —
# nunca exponha ao app. Chamada via REST direta (sem SDK), ver
# src/lib/interpretacao.ts. Tier grátis do 2.5 Flash: sem cartão, não expira,
# 1.500 req/dia (conferir limites atuais em ai.google.dev antes de ir a público).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Timeout por chamada não-streaming, em ms.
GEMINI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Supabase (perfis, mapas_natais, leituras_diarias, interpretacoes_signos,
# mensagens, sinastrias, geocoding_cache — schema em supabase/schema.sql).
# A service role ignora RLS: só no servidor, nunca exponha ao app.
# SUPABASE_ANON_KEY não é usada pelo backend hoje (o app não fala com o
# Supabase Auth direto — cadastro/login passam pelo backend), mas fica
# documentada aqui para quando isso for reavaliado.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Origens permitidas no CORS, separadas por vírgula. Vazio = só mesma origem.
# P2 item 12: restringir em produção (o serviço Python hoje usa allow_origins=["*"]).
ALLOWED_ORIGINS=
